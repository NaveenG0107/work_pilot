# For Posgress
DATABASE_URL = postgresql+psycopg://username:password@host.docker.internal:5432/workpilot

# For mysql
# DATABASE_URL= mysql+mysqlconnector://username:password@host.docker.internal3306/test_db

# For MSSQL
# DATABASE_URL=mssql+pyodbc://username:password@host.docker.internal:1433/test_db?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

JWT_SECRET_KEY=Your-Secret-Key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase S3 storage (required for task attachments; no local fallback)
S3_ENDPOINT=https://rywvrcvpgeenhvlyrtaj.storage.supabase.co/storage/v1/s3
S3_PUBLIC_ENDPOINT=https://rywvrcvpgeenhvlyrtaj.supabase.co/storage/v1/object/public
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
S3_BUCKET=work_pilot_bucket
# Maximum task attachment size in megabytes (default: 5)
S3_MAX_FILE_SIZE_MB=5
# Maximum number of attachments accepted in one request (default: 5)
ATTACHMENT_MAX_FILE_SIZE_MB=10
ATTACHMENT_MAX_FILES_COUNT=5
REDIS_HOST=redis
REDIS_PORT=6379
